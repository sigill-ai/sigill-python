{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sigill.ai/control-evaluation/v1.json",
  "title": "ControlEvaluation",
  "description": "Sibling profile of AiEvidenceEnvelopeV2: a verifier's observed state and control results, bound to run_end and the Control Artifact. See control-evaluation-v1.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaName",
    "schemaVersion",
    "evidenceId",
    "createdAt",
    "actor",
    "activity",
    "subject",
    "controlSet",
    "controls",
    "overall",
    "evaluatedAt",
    "objects"
  ],
  "properties": {
    "schemaName": {
      "type": "string",
      "const": "ControlEvaluation"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1"
    },
    "evidenceId": {
      "type": "string",
      "format": "uuid",
      "description": "A bare UUID, as the v2 family core requires. Verifiers also accept the urn:uuid: form (common rules §1)."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Producer's clock, RFC 3339 UTC. Seal time is proven by sigTst."
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "version"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "verifier"
          ],
          "description": "Who produced this artifact."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable identifier. Not a display name, not PII."
        },
        "version": {
          "type": "string",
          "description": "Version of the producing component."
        },
        "tenantId": {
          "type": "string"
        },
        "displayHint": {
          "type": "string"
        }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "correlationId"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "description": "The run identifier; identical in every artifact of one run."
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      },
      "description": "Producer-private data, as AiEvidenceEnvelopeV2 §2."
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runEndSignatureSha256",
        "controlArtifactSignatureSha256"
      ],
      "properties": {
        "runEndSignatureSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "controlArtifactSignatureSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "controlSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "result"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "INDETERMINATE"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "overall": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "INDETERMINATE"
      ]
    },
    "evaluatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "objects": {
      "type": "array",
      "description": "Exactly one control-set and at most one baseline-state (both same URI and digest as in the Control Artifact); at least one observed-state.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "uri",
          "role"
        ],
        "properties": {
          "uri": {
            "type": "string",
            "minLength": 1,
            "description": "Opaque, byte-exact match with sigD.pars; never 'urn:sigill:envelope'."
          },
          "role": {
            "type": "string",
            "enum": [
              "observed-state",
              "control-set",
              "baseline-state"
            ]
          },
          "contentType": {
            "type": "string"
          },
          "encoding": {
            "type": "string",
            "enum": [
              "utf-8",
              "binary"
            ]
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "minItems": 2,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "role": {
                "const": "control-set"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "role": {
                "const": "observed-state"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "role": {
                "const": "baseline-state"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        }
      ]
    }
  }
}
