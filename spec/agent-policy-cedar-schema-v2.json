{
  "": {
    "commonTypes": {
      "Facts": {
        "type": "Record",
        "attributes": {
          "consequential": { "type": "Boolean", "required": true },
          "operation": { "type": "String", "required": true },
          "stepsSoFar": { "type": "Long", "required": true },
          "approval": { "type": "String", "required": true },
          "isChildRun": { "type": "Boolean", "required": true },
          "totalSteps": { "type": "Long", "required": true },
          "consequentialCount": { "type": "Long", "required": true },
          "unpairedConsequential": { "type": "Long", "required": true },
          "toolCallsSoFar": { "type": "Long", "required": true },
          "callsOfThisTool": { "type": "Long", "required": true },
          "denialsSoFar": { "type": "Long", "required": true }
        }
      }
    },
    "entityTypes": {
      "Agent": { "memberOfTypes": ["AgentGroup"] },
      "AgentGroup": {},
      "Tool": {
        "memberOfTypes": ["ToolGroup"],
        "shape": {
          "type": "Record",
          "attributes": {
            "definitionSha256": { "type": "String", "required": false },
            "consequential": { "type": "Boolean", "required": false }
          }
        }
      },
      "ToolGroup": { "memberOfTypes": ["ToolGroup"] },
      "Step": {},
      "Run": {}
    },
    "actions": {
      "run_start": { "appliesTo": { "principalTypes": ["Agent"], "resourceTypes": ["Step"], "context": { "type": "Facts" } } },
      "retrieval": { "appliesTo": { "principalTypes": ["Agent"], "resourceTypes": ["Step"], "context": { "type": "Facts" } } },
      "tool_call": { "appliesTo": { "principalTypes": ["Agent"], "resourceTypes": ["Tool"], "context": { "type": "Facts" } } },
      "authorization": { "appliesTo": { "principalTypes": ["Agent"], "resourceTypes": ["Step"], "context": { "type": "Facts" } } },
      "human_approval": { "appliesTo": { "principalTypes": ["Agent"], "resourceTypes": ["Step"], "context": { "type": "Facts" } } },
      "tool_result": { "appliesTo": { "principalTypes": ["Agent"], "resourceTypes": ["Tool"], "context": { "type": "Facts" } } },
      "model_output": { "appliesTo": { "principalTypes": ["Agent"], "resourceTypes": ["Step"], "context": { "type": "Facts" } } },
      "checkpoint": { "appliesTo": { "principalTypes": ["Agent"], "resourceTypes": ["Step"], "context": { "type": "Facts" } } },
      "run_end": { "appliesTo": { "principalTypes": ["Agent"], "resourceTypes": ["Step"], "context": { "type": "Facts" } } },
      "delegation": { "appliesTo": { "principalTypes": ["Agent"], "resourceTypes": ["Step"], "context": { "type": "Facts" } } },
      "delegation_result": { "appliesTo": { "principalTypes": ["Agent"], "resourceTypes": ["Step"], "context": { "type": "Facts" } } },
      "run": { "appliesTo": { "principalTypes": ["Agent"], "resourceTypes": ["Run"], "context": { "type": "Facts" } } }
    }
  }
}
